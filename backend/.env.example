# TRADEx-ALGO Environment Configuration Example
# Copy to .env and configure your real credentials

# Angel One SmartAPI Credentials (Optional - defaults to simulated paper feed if not provided)
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PIN=your_mpin_here
ANGEL_TOTP_SECRET=your_totp_qr_secret_here

# Supabase Realtime Cloud Sync (Optional)
SUPABASE_URL=
SUPABASE_KEY=

# Telegram Alerts Broadcast Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server Port
PORT=7860
